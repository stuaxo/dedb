 "reviews": [
  {
   "createdate": "2016-02-15 23:40:58",
   "reviewbody": "This is a great game.  Played it with my son when he was a kid.  There are many levels and you have restoration places along the way, so that if you die, you return from there as apposed to the start of the game.  Good fun and good strategy as well.\nIt works well with the emulator - and also works well on large screen LCD, if you connect a PC up to one.",
   "reviewdate": "2016-02-15 23:40:58",
   "reviewer": "R2AD",
   "reviewtitle": "Great Game",
   "stars": "5"
  }
 ],
